# Copy to .env and fill in. Placeholder values only — never commit real secrets.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# One URL, used by both the running API and the TypeORM CLI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/purposemint
DATABASE_SSL=false

# --- Access tokens --------------------------------------------------------
# Generate with: openssl rand -base64 48   (must be at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m

# --- Refresh sessions -----------------------------------------------------
REFRESH_TTL_DAYS_MOBILE=30
REFRESH_TTL_DAYS_DASHBOARD=7

# --- One-time codes -------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Password hashing -----------------------------------------------------
BCRYPT_ROUNDS=12

# --- Rate limiting (global default; auth routes are tighter in code) -------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- CORS -----------------------------------------------------------------
DASHBOARD_URL=http://localhost:3001
# Extra allowed origins, comma-separated. DASHBOARD_URL is always included.
CORS_ORIGINS=

# --- Optional: seed an admin account on first boot ------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Optional: seed S3 storage config on first boot -----------------------
INITIAL_AWS_ACCESS_KEY_ID=
INITIAL_AWS_SECRET_ACCESS_KEY=
INITIAL_AWS_REGION=
INITIAL_AWS_S3_BUCKET=

# --- Optional: seed SMTP config on first boot -----------------------------
INITIAL_SMTP_SERVER=
INITIAL_SMTP_PORT=
INITIAL_SMTP_EMAIL_USER=
INITIAL_SMTP_EMAIL_PASSWORD=
INITIAL_SMTP_BCC=
INITIAL_SMTP_ENABLED=false
