# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=muakhah

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Optional: seed S3 config into database on first startup (not stored in env after seed)
INITIAL_AWS_ACCESS_KEY_ID=
INITIAL_AWS_SECRET_ACCESS_KEY=
INITIAL_AWS_REGION=
INITIAL_AWS_S3_BUCKET=

# Optional: seed SMTP config into database on first startup
INITIAL_SMTP_SERVER=
INITIAL_SMTP_PORT=
INITIAL_SMTP_EMAIL_USER=
INITIAL_SMTP_EMAIL_PASSWORD=
INITIAL_SMTP_BCC=
INITIAL_SMTP_ENABLED=false

# Server
PORT=4000
NODE_ENV=development
DASHBOARD_URL=http://localhost:3001
LANDING_URL=http://localhost:3000
